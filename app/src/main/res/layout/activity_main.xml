<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Container Principale WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone" />

    <!-- Container Schermo Intero per Player HTML5 (CustomView) -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

    <!-- Schermata di Caricamento Iniziale -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/bg_dark">

        <ImageView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/app_icon"
            android:contentDescription="@string/app_name" />

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/accent_cyan" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_message"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Schermata di Errore con Tasto Riprova -->
    <LinearLayout
        android:id="@+id/errorLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@color/bg_dark">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_message"
            android:textColor="@color/text_muted"
            android:textSize="18sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRetry"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/retry"
            android:backgroundTint="@color/accent_blue"
            android:textColor="@color/white"
            android:padding="12dp"
            android:textSize="16sp"
            android:focusable="true" />
    </LinearLayout>

    <!-- Floating HUD per notifica modalità (Telecomando / Cursore Virtuale) -->
    <TextView
        android:id="@+id/tvModeHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_hud_badge"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Puntatore Virtuale Mouse per telecomando TV -->
    <ImageView
        android:id="@+id/virtualCursor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_cursor"
        android:visibility="gone"
        android:elevation="15dp"
        android:contentDescription="Virtual Mouse Cursor" />

</FrameLayout>
